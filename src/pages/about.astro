---
import Base from '../layouts/Base.astro';
import Landscape from '../components/Landscape.astro';
import { site, heldCredentials } from '../config';
const held = heldCredentials();
---
<Base title="About" description="Three Tickets to Adventure is a small Flagstaff company: one car, one local driver, private trips across Northern Arizona.">
  <section>
    <div class="wrap split">
      <div>
        <nav class="crumbs small" aria-label="Breadcrumb"><a href="/">Home</a></nav>
        <p class="eyebrow">About</p>
        <h1>Small on purpose</h1>
        <p class="lede">
          {site.name} is one car and one local driver in {site.base.city}. That is the whole point: the person who
          answers your message is the person who picks you up.
        </p>
        {site.driver.bio.map((p) => <p>{p}</p>)}
        <p class="sig">{site.driver.name}</p>
      </div>
      <div class="card portrait">
        <Landscape variant="night" />
        <p class="small muted cap">A photo of the driver and the car goes here.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>How we work</h2>
      <div class="grid grid-3 how">
        <div>
          <h3>We only sell what we are allowed to run</h3>
          <p class="muted">Trips on National Park, National Forest or Navajo Nation land open only once the permit is issued. You will see "opening" on those trips until then.</p>
        </div>
        <div>
          <h3>Arizona only</h3>
          <p class="muted">Every trip starts and ends in Arizona. That keeps us inside the rules we are licensed for, and it is where we know the roads.</p>
        </div>
        <div>
          <h3>Honest prices</h3>
          <p class="muted">The price on the page includes Arizona tax. Park fees and tastings are passed on at cost and listed on each trip.</p>
        </div>
      </div>
      {held.length > 0 && (
        <div class="creds">
          <h3>Licensed and insured</h3>
          <ul class="ticks">{held.map((c) => <li>{c.label}{c.detail ? `: ${c.detail}` : ''}</li>)}</ul>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .crumbs { margin-bottom: 18px; }
  .crumbs a { color: var(--ink-muted); }
  h1 { margin-bottom: 14px; }
  .split { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 860px) { .split { grid-template-columns: 1.1fr 0.9fr; gap: 56px; } }
  .portrait { aspect-ratio: 4 / 5; position: relative; }
  .cap { position: absolute; left: 0; right: 0; bottom: 0; margin: 0; padding: 12px 16px; background: rgba(251,248,243,.92); }
  .sig { font-family: var(--font-display); font-size: 1.3rem; color: var(--pine-900); }
  .how { margin-top: 20px; }
  .how h3 { margin-bottom: 8px; }
  .creds { margin-top: 32px; }
  .creds h3 { margin-bottom: 12px; }
</style>
