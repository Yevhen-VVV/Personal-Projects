---
import Base from '../layouts/Base.astro';
import { site } from '../config';
const v = site.vehicle;
---
<Base title="The car" description={`Every trip runs in a ${v.model}: leather, quiet hybrid power and a panoramic roof. Up to ${v.maxGuests} guests, one party per car.`}>
  <section>
    <div class="wrap split">
      <div>
        <nav class="crumbs small" aria-label="Breadcrumb"><a href="/">Home</a></nav>
        <p class="eyebrow">The car</p>
        <h1>One car, kept for you</h1>
        <p class="lede">
          Every trip runs in the same {v.model}. No fleet of tired vans, no swapping vehicles halfway:
          the car that picks you up is the one you ride all day.
        </p>
        <div class="btn-row" data-primary-cta>
          <a class="btn btn-book" href="/book/">Request a trip</a>
        </div>
      </div>
      <figure class="card plan">
        <svg viewBox="0 0 320 446" role="img" aria-labelledby="plan-t">
          <title id="plan-t">Seating plan: driver and front passenger, two 2nd-row captain's chairs, three-seat third row</title>
          <rect x="60" y="20" width="200" height="380" rx="70" fill="#f4eee4" stroke="#1f4d3d" stroke-width="3" />
          <rect x="88" y="82" width="58" height="62" rx="12" fill="#55635d" />
          <text x="117" y="164" text-anchor="middle" font-size="12" fill="#55635d" font-family="Inter Variable, sans-serif">Driver</text>
          <rect x="174" y="82" width="58" height="62" rx="12" fill="#1f4d3d" />
          <rect x="88" y="186" width="58" height="62" rx="12" fill="#1f4d3d" />
          <rect x="174" y="186" width="58" height="62" rx="12" fill="#1f4d3d" />
          <text x="160" y="276" text-anchor="middle" font-size="12" fill="#1f4d3d" font-family="Inter Variable, sans-serif" font-weight="600">Best 3 seats</text>
          <rect x="86" y="296" width="148" height="56" rx="12" fill="#b14a25" opacity=".8" />
          <text x="160" y="430" text-anchor="middle" font-size="13" fill="#923b1c" font-family="Inter Variable, sans-serif">Third row: 3 seats, best for kids</text>
        </svg>
        <figcaption class="small muted">Seating as configured with 2nd-row captain's chairs. Guests 4 to 6 ride in the third row.</figcaption>
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>What you ride in</h2>
      <ul class="ticks feats">
        {v.features.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>How we look after it</h2>
      <div class="grid grid-3 care">
        <div>
          <h3>Inspected, not just washed</h3>
          <p class="muted">Brakes and tires are checked by a qualified shop at least once a year, as Arizona requires of every vehicle for hire, and the records are kept for two years.</p>
        </div>
        <div>
          <h3>Ready for the season</h3>
          <p class="muted">{v.drive}, so winter tires go on before the snow, and rough Forest roads are off the route. If the roads are not safe, we move your trip.</p>
        </div>
        <div>
          <h3>Zero tolerance</h3>
          <p class="muted">No alcohol or drugs for the driver, ever. Guests: no open containers in the car. Read the <a href="/legal/safety/">full policy</a>.</p>
        </div>
      </div>
      <p class="small muted note">The car is not wheelchair accessible. A folding wheelchair fits in the back with 3 or fewer guests. Ask us about anything else that matters to you.</p>
    </div>
  </section>
</Base>

<style>
  .crumbs { margin-bottom: 18px; }
  .crumbs a { color: var(--ink-muted); }
  h1 { margin-bottom: 14px; }
  .lede { margin-bottom: 24px; }
  .split { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 860px) { .split { grid-template-columns: 1.1fr 0.9fr; gap: 56px; } }
  .plan { margin: 0; padding: 20px; }
  .plan svg { width: 100%; max-width: 300px; margin: 0 auto; }
  .plan figcaption { text-align: center; margin-top: 10px; }
  .feats { margin-top: 20px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .feats { grid-template-columns: 1fr 1fr; column-gap: 32px; } }
  .care { margin-top: 20px; }
  .care h3 { margin-bottom: 8px; }
  .note { margin-top: 24px; }
</style>
