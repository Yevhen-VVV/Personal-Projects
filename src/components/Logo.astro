---
interface Props { inverse?: boolean }
const { inverse = false } = Astro.props;
---
<span class:list={['logo', { inverse }]}>
  <svg class="mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="10" fill={inverse ? '#fbf8f3' : '#1f4d3d'} />
    <g fill="none" stroke={inverse ? '#1f4d3d' : '#fbf8f3'} stroke-width="2" stroke-linejoin="round">
      <path d="M8 13h24v4a3 3 0 0 0 0 6v4H8v-4a3 3 0 0 0 0-6z" />
      <path d="M11 10h18" opacity=".7" />
      <path d="M14 7h12" opacity=".45" />
    </g>
    <path d="M13 24l4-6 3 3 2-2 5 5" fill="none" stroke="#e08a5f" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
  </svg>
  <span class="words">
    <span class="w1">Three Tickets</span>
    <span class="w2">to Adventure</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--pine-900); }
  .mark { width: 38px; height: 38px; flex: none; }
  .words { display: flex; flex-direction: column; line-height: 1; }
  .w1 { white-space: nowrap; font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; letter-spacing: -0.01em; }
  .w2 { font-size: .66rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-muted); margin-top: 4px; }
  .inverse { color: var(--sand-50); }
  .inverse .w2 { color: #c9d6cf; }
</style>
