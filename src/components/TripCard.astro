---
import Landscape from './Landscape.astro';
import { type Trip, fromPrice, usd, seasonLabel } from '../lib/trips';
interface Props { trip: Trip; headingLevel?: 'h2' | 'h3' }
const { trip, headingLevel = 'h3' } = Astro.props;
const d = trip.data;
const H = headingLevel;
---
<article class="card trip-card">
  <a class="art" href={`/trips/${trip.id}/`} tabindex="-1" aria-hidden="true">
    <Landscape variant={d.art} />
    <span class:list={['pill', d.bookable ? 'pill-open' : 'pill-soon', 'status']}>{d.bookable ? 'Taking requests' : d.launch}</span>
  </a>
  <div class="body">
    <p class="cat">{d.category}</p>
    <H class="title"><a href={`/trips/${trip.id}/`}>{d.title}</a></H>
    <p class="summary">{d.summary}</p>
    <ul class="meta">
      <li>{d.hours}</li>
      <li>Up to {d.maxGuests} guests</li>
      <li>{d.effort}</li>
      <li>{seasonLabel(d.months)}</li>
    </ul>
    <div class="foot">
      <p class="price"><span class="from">From</span> <strong>{usd(fromPrice(trip))}</strong> <span class="per">per car, up to 4</span></p>
      <a class="more" href={`/trips/${trip.id}/`}>View trip <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>

<style>
  .trip-card { display: flex; flex-direction: column; }
  .art { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; }
  .status { position: absolute; left: 14px; top: 14px; }
  .body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
  .cat { font-size: .75rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 6px; }
  .title { font-size: 1.3rem; }
  .title a { text-decoration: none; color: var(--pine-900); }
  .title a:hover { text-decoration: underline; }
  .summary { color: var(--ink-muted); font-size: .95rem; margin: 10px 0 14px; }
  .meta { list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-wrap: wrap; gap: 6px; font-size: .82rem; color: var(--ink-muted); }
  .meta li { background: var(--sand-100); border-radius: 6px; padding: 3px 8px; }
  .foot { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line); display: flex; align-items: end; justify-content: space-between; gap: 12px; }
  .price { margin: 0; line-height: 1.2; }
  .from { display: block; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
  .price strong { font-family: var(--font-display); font-size: 1.5rem; color: var(--pine-900); }
  .per { font-size: .82rem; color: var(--ink-muted); }
  .more { font-weight: 600; text-decoration: none; white-space: nowrap; }
</style>
